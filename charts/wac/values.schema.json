{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "wac values schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 0 },
    "storageClass": { "type": "string" },
    "updateStrategy": { "type": "string", "enum": ["RollingUpdate", "Recreate"] },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "preventRoot": { "type": "boolean" },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of Secret names for pulling images from private registries"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["IfNotPresent", "Always", "Never"] }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": { "type": ["integer", "string" ] },
        "ports": {
          "type": "array",
          "description": "Multiple ports for the service (e.g., HTTP + WebSocket)",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "description": "Port name (e.g., http, ws)" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "targetPort": { "type": ["integer", "string"] },
              "protocol": { "type": "string", "enum": ["TCP", "UDP"] }
            },
            "required": ["name", "port", "targetPort"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "certificateArn": { "type": "string" },
        "groupName": { "type": "string" },
        "customAnnotations": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "hosts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "path": { "type": "string" },
        "additionalRoutesBefore": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "pathType": { "type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"] },
              "serviceName": { "type": "string", "description": "Service name (defaults to current service)" },
              "servicePort": { "type": ["integer", "string"], "description": "Service port number" }
            },
            "required": ["path"],
            "additionalProperties": false
          }
        },
        "additionalRoutesAfter": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "pathType": { "type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"] },
              "serviceName": { "type": "string", "description": "Service name (defaults to current service)" },
              "servicePort": { "type": ["integer", "string"], "description": "Service port number" }
            },
            "required": ["path"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "sftp": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "username": { "type": "string" },
              "password": { "type": "string" },
              "uid": { "type": "integer", "minimum": 0 },
              "gid": { "type": "integer", "minimum": 0 }
            },
            "required": ["username", "password"],
            "additionalProperties": false
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "tag": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "properties": {
        "command": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Override container command"
        },
        "args": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Override container args"
        },
        "customHtaccessCM": { "type": "string" },
        "existingSecretsEnv": {
          "type": "array",
          "items": { "type": "string" }
        },
        "existingConfigMapsEnv": {
          "type": "array",
          "items": { "type": "string" }
        },
        "env": {
          "type": "object",
          "description": "Mappa di variabili d'ambiente",
          "additionalProperties": { "type": "string" }
        },
        "customIniCM": { "type": "string" },
        "resources": { "type": "object" },
        "uid": { "type": "integer", "minimum": 0 },
        "gid": { "type": "integer", "minimum": 0 },
        "gracefulShutdownSeconds": { "type": "integer", "minimum": 0 },
        "serviceAccountName": { "type": "string" },
        "nodeAffinity": {
          "type": "object",
          "description": "Mappa chiave->valore per node affinity/tolerations",
          "additionalProperties": { "type": "string" }
        },
        "preventSameNode": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "onePasswordSecrets": {
      "type": "array",
      "description": "List of 1Password items to sync as Kubernetes Secrets",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Name of the OnePasswordItem and resulting Secret" },
          "item": { "type": "string", "description": "Item name in the 1Password vault" },
          "vault": { "type": "string", "description": "Vault name (default: eks)" },
          "autoRestart": { "type": "boolean", "description": "Auto-restart pods when secret changes (default: true)" },
          "mountPaths": {
            "type": "array",
            "description": "Mount the secret as volume files",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "path": { "type": "string" },
                "subPath": { "type": "string" }
              },
              "required": ["name", "path"],
              "additionalProperties": false
            }
          }
        },
        "required": ["name", "item"],
        "additionalProperties": false
      }
    },
    "scheduler": {
      "type": "object",
      "description": "Per-release supercronic Deployment for cronjobs with runIn: scheduler",
      "properties": {
        "resources": { "type": ["object", "null"], "description": "Resource limits/requests of the scheduler pod" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0, "description": "Keep >= the longest scheduler job: on SIGTERM supercronic waits for running jobs" },
        "metrics": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          },
          "additionalProperties": false
        },
        "timeZone": { "type": "string", "description": "IANA time zone for the schedules (CRON_TZ). Empty = container time zone (TZ)" },
        "extraArgs": { "type": "array", "items": { "type": "string" }, "description": "Additional supercronic flags" }
      },
      "additionalProperties": false
    },
    "cronjobDefaults": {
      "type": "object",
      "description": "Defaults for cronjobs with runIn: job. Precedence: job value > cronjobDefaults > not emitted",
      "properties": {
        "resources": { "type": ["object", "null"] },
        "ttlSecondsAfterFinished": { "type": ["integer", "null"], "minimum": 0 },
        "activeDeadlineSeconds": { "type": ["integer", "null"], "minimum": 1 },
        "backoffLimit": { "type": ["integer", "null"], "minimum": 0 },
        "timeZone": { "type": "string" }
      },
      "additionalProperties": false
    },
    "cronjobs": {
      "type": "array",
      "description": "List of CronJob definitions",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "CronJob name (appended to release name)" },
          "schedule": { "type": "string", "description": "Cron schedule expression" },
          "runIn": { "type": "string", "enum": ["job", "scheduler"], "description": "job (default): Kubernetes CronJob, one pod per run. scheduler: runs in the per-release supercronic Deployment" },
          "timeZone": { "type": "string", "description": "IANA time zone name for the schedule (e.g. Europe/Rome). Requires Kubernetes >= 1.27. Default: cronjobDefaults.timeZone; empty = kube-controller-manager local time (UTC on EKS)" },
          "command": { "type": "array", "items": { "type": "string" }, "description": "Container command" },
          "args": { "type": "array", "items": { "type": "string" }, "description": "Container args" },
          "image": { "type": "string", "description": "Override image (defaults to main image)" },
          "resources": { "type": ["object", "null"], "description": "Resource limits/requests (default: cronjobDefaults.resources; {} = none)" },
          "env": { "type": "object", "description": "Additional env vars", "additionalProperties": { "type": "string" } },
          "concurrencyPolicy": { "type": "string", "enum": ["Allow", "Forbid", "Replace"] },
          "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
          "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
          "startingDeadlineSeconds": { "type": "integer", "minimum": 0, "description": "Deadline in seconds for starting the job if it misses its scheduled time" },
          "ttlSecondsAfterFinished": { "type": ["integer", "null"], "minimum": 0, "description": "Seconds after which a finished Job is deleted (default: cronjobDefaults.ttlSecondsAfterFinished; null = never)" },
          "activeDeadlineSeconds": { "type": ["integer", "null"], "minimum": 1, "description": "Max duration in seconds the job may run before it is terminated (default: cronjobDefaults.activeDeadlineSeconds; null = no limit)" },
          "backoffLimit": { "type": ["integer", "null"], "minimum": 0, "description": "Number of retries before marking the job failed (default: cronjobDefaults.backoffLimit; null = Kubernetes default 6)" },
          "restartPolicy": { "type": "string", "enum": ["OnFailure", "Never"] },
          "suspend": { "type": "boolean" },
          "volumes": { "type": "array", "items": { "type": "string" }, "description": "Volume names from main volumes to mount" }
        },
        "required": ["name", "schedule"],
        "additionalProperties": false
      }
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "mountPaths": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "path": { "type": "string" },
                "subPath": { "type": "string", "description": "SubPath for mounting a single file from ConfigMap/Secret" }
              },
              "required": ["name", "path"],
              "additionalProperties": false
            }
          },
          "configMap": { "type": "string" },
          "secret": { "type": "string" },
          "accessMode": { "type": "string", "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadOnlyMany"] },
          "size": { "type": "string" },
          "storageClass": { "type": "string" },
          "sftpAccess": { "type": "boolean" }
        },
        "required": ["name", "mountPaths"],
        "additionalProperties": false
      }
    },
    "extraVolumes": {
      "type": "array",
      "description": "Raw pod volume specs rendered verbatim onto the Deployment (projected, csi, emptyDir, ...). Pair with extraVolumeMounts.",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" }
        },
        "required": ["name"],
        "additionalProperties": true
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "description": "Raw container volumeMount specs rendered verbatim onto the main container. name must match an extraVolumes entry.",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "mountPath": { "type": "string" },
          "readOnly": { "type": "boolean" },
          "subPath": { "type": "string" }
        },
        "required": ["name", "mountPath"],
        "additionalProperties": true
      }
    }
  }
}
